        }
      }
      member_roles {
        value
        name
        inviteable
        is_free
      }
      isViewerRoleHidden
      workspaceMigrationEligibleDate
      isMigrationCompleted
    }
    was_loom_user_before_membership
    onboarding
    member_limits
  }
}
