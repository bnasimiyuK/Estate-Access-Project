    query JiraFieldSearch($siteId: String!, $field: JiraSearchableFieldType!, $query: String) {
  jiraFieldSearch(siteId: $siteId, field: $field, query: $query) {
    __typename
    ... on Error {
      message
    }
    ... on JiraFieldSearchPayload {
      needsAtlassianAuth
      responseMessage
      results {
        __typename
        ... on JiraFieldProjects {
          projects {
            id
            name
            siteId
          }
        }
        ... on JiraFieldIssueTypes {
          issueTypes {
            id
            name
            siteId
          }
        }
        ... on JiraFieldAssignees {
          assignees {
            accountId
            displayName
          }
        }
      }
    }
  }
}
