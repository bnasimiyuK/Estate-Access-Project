    query GetVideoAttachments($videoId: ID!, $password: String) {
  getVideo(id: $videoId, password: $password) {
    ... on RegularUserVideo {
      id
      attachments {
        id
        url
        service {
          name
          humanName
        }
      }
    }
  }
}
