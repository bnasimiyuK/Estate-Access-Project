// reset_password.js (Using CommonJS for broader compatibility)

// ⚠️ Use 'require' instead of 'import' for standard Node.js execution
const bcrypt = require("bcryptjs");

// ===============================================
// 🔑 STEP 1: DEFINE THE NEW PASSWORD
// ===============================================
const newPassword = "NewPWD2025!"; 
// IMPORTANT: Change this password and tell the user to change it immediately after login.

async function generateHash() {
    // Bcrypt uses a cost factor (salt rounds). 10 is standard.
    const saltRounds = 10; 
    
    try {
        console.log("Generating secure bcrypt hash...");
        
        // Hash the new password asynchronously
        const newHash = await bcrypt.hash(newPassword, saltRounds);
        
        // ----------------- OUTPUT START -----------------
        console.log("=========================================");
        console.log(`User's Temporary Password: ${newPassword}`);
        console.log(`\n✅ New PasswordHash for the Database (COPY THIS ENTIRE STRING):`);
        console.log(newHash); 
        console.log("=========================================");
        // ----------------- OUTPUT END -----------------
        
    } catch (error) {
        // This is crucial: It ensures an error is logged if bcrypt fails
        console.error("❌ ERROR: Failed to generate hash.", error.message);
        console.error("Ensure 'bcryptjs' is installed in your project: npm install bcryptjs");
    }
}

generateHash();