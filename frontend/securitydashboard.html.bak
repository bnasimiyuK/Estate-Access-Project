<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Athi Estate Access Management System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="css/styles.css"/>
</head>
<body class="text-white min-h-screen flex flex-col relative bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900">
<div id="header"></div>

  <!-- Background Video -->
  <video autoplay muted loop playsinline class="absolute top-0 left-0 w-full h-full object-cover opacity-40 -z-10">
    <source src="assets/Hero.webm" type="video/mp4">
  </video>

  <!-- Dark overlay for contrast -->
  <div class="absolute inset-0 bg-black/60 -z-10"></div>

  <!-- Main Content -->
  <main class="mt-28 px-4 flex-grow">

    <!-- Security Dashboard -->
    <section class="max-w-6xl mx-auto bg-gray-900/70 p-8 rounded-2xl shadow-2xl backdrop-blur-md border border-gray-700">
      <h1 class="text-3xl font-bold mb-8 text-center text-blue-400">Security Dashboard</h1>

      <!-- Dashboard Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <div class="bg-slate-800/80 hover:bg-slate-700/80 p-6 rounded-xl shadow-lg flex flex-col items-center transition-all duration-200">
          <h2 class="text-xl font-semibold mb-2 text-gray-200">Active Visitors</h2>
          <p class="text-4xl font-bold text-blue-400" id="activeVisitors">12</p>
        </div>

        <div class="bg-slate-800/80 hover:bg-slate-700/80 p-6 rounded-xl shadow-lg flex flex-col items-center transition-all duration-200">
          <h2 class="text-xl font-semibold mb-2 text-gray-200">Security Alerts</h2>
          <p class="text-4xl font-bold text-red-500" id="securityAlerts">2</p>
        </div>

        <div class="bg-slate-800/80 hover:bg-slate-700/80 p-6 rounded-xl shadow-lg flex flex-col items-center transition-all duration-200">
          <h2 class="text-xl font-semibold mb-3 text-gray-200">Recent Logs</h2>
          <ul id="recentLogs" class="text-gray-300 text-sm space-y-1 text-center">
            <li>Beverly entered at 09:12 AM</li>
            <li>Visitor #23 exited at 09:45 AM</li>
            <li>Alarm triggered at Gate B</li>
          </ul>
        </div>
      </div>

      <!-- Visitor Pass Generator -->
      <div class="bg-slate-800/80 p-8 rounded-xl shadow-md mb-8 border border-gray-700">
        <h2 class="text-2xl font-semibold mb-6 text-center text-blue-300">Generate Visitor Pass</h2>
        <form id="visitorPassForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input type="text" id="visitorName" placeholder="Visitor Name" class="p-3 rounded-lg text-gray-900 w-full focus:ring-2 focus:ring-blue-500">
          <input type="text" id="residentName" placeholder="Resident Name" class="p-3 rounded-lg text-gray-900 w-full focus:ring-2 focus:ring-blue-500">
          <input type="text" id="visitorID" placeholder="Visitor ID/Phone" class="p-3 rounded-lg text-gray-900 w-full focus:ring-2 focus:ring-blue-500">
          <input type="date" id="visitDate" class="p-3 rounded-lg text-gray-900 w-full focus:ring-2 focus:ring-blue-500">
          <input type="time" id="visitTime" class="p-3 rounded-lg text-gray-900 w-full focus:ring-2 focus:ring-blue-500">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md transition w-full">
            Generate Pass
          </button>
        </form>
        <div id="generatedPass" class="mt-6 p-4 bg-gray-700/70 rounded-lg text-center text-gray-200 hidden">
          <!-- Generated pass will appear here -->
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap justify-center gap-4">
        <button class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md transition">
          View All Visitors
        </button>
        <button class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md transition">
          Trigger Alert
        </button>
        <button class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md transition">
          Resolve Alerts
        </button>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-blue-900 text-white text-center py-3 text-sm border-t border-blue-800">
    <p>&copy; <span id="year"></span> Athi Estate Access System. All rights reserved.</p>
  </footer>

  <!-- Scripts -->
  <script src="js/main.js"></script>
  <script src="js/navbar.js"></script>
  <script>
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>

</body>
</html>
